{
  "name": "ai-glasses-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "dev:vision": "D:\\ai-glasses-gpu\\.venv\\Scripts\\python.exe -m uvicorn app:app --app-dir vision-server --host 127.0.0.1 --port 8000",
    "dev": "concurrently -k -n SERVER,CLIENT,GPU -c blue,green,magenta \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:vision\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
